  m_text: "\n\u03A3\u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2 \u03C4\u03BF\u03C5
    20\u03BF\u03CD \u03B1\u03B9\u03CE\u03BD\u03B1, \u03C4\u03B1 \u03C4\u03B1\u03BE\u03AF\u03B4\u03B9\u03B1
    \u03BC\u03B5 \u03B1\u03C4\u03BC\u03CC\u03C0\u03BB\u03BF\u03B9\u03BF \u03BA\u03B1\u03B9
    \u03C4\u03C1\u03AD\u03BD\u03BF \u03AD\u03C6\u03B5\u03C1\u03B1\u03BD \u03BD\u03AD\u03B5\u03C2
    \u03C3\u03C5\u03BD\u03AE\u03B8\u03B5\u03B9\u03B5\u03C2. \u0397 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
    \u03C0\u03B5\u03C1\u03B9\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03C0\u03BB\u03AD\u03BF\u03BD
    \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9, \u03B1\u03BB\u03BB\u03AC \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF
    \u03C4\u03BF\u03BD \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7."
