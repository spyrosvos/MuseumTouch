  m_text: "\n\u03A4\u03BF \"\u03C8\u03C5\u03B3\u03B5\u03AF\u03BF\" \u03C4\u03B7\u03C2
    \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03AC\u03B5\u03B9
    \u03C4\u03B1 \u03C4\u03C1\u03CC\u03C6\u03B7\u03BC\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03C5\u03BC\u03AD\u03BD\u03B1
    \u03BA\u03B1\u03B9 \u03C6\u03C1\u03AD\u03C3\u03BA\u03B1. \u0397 \u03C3\u03AF\u03C4\u03B1
    \u03BA\u03C1\u03B1\u03C4\u03AC\u03B5\u03B9 \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC
    \u03AD\u03BD\u03C4\u03BF\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03C1\u03C9\u03BA\u03C4\u03B9\u03BA\u03AC,
    \u03B5\u03BD\u03CE \u03BF \u03B1\u03AD\u03C1\u03B1\u03C2 \u03BA\u03C5\u03BA\u03BB\u03BF\u03C6\u03BF\u03C1\u03B5\u03AF
    \u03C3\u03C4\u03BF \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03CC."
