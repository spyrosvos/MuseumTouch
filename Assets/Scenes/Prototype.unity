  m_text: "\n\u03A6\u03B5\u03CD\u03B3\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
    \u03C3\u03C0\u03AF\u03C4\u03B9 \u03BA\u03B1\u03B9 \u03B3\u03C5\u03C1\u03AF\u03B6\u03B5\u03B9
    \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF: \u03C5\u03C6\u03AC\u03C3\u03BC\u03B1\u03C4\u03B1,
