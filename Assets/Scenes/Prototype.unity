  m_text: "\n\u0391\u03B3\u03B3\u03AF\u03BE\u03C4\u03B5 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1
    \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1 \u03B4\u03C9\u03BC\u03AC\u03C4\u03B9\u03B1
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C4\u03B1 \u03B5\u03BE\u03B5\u03C4\u03AC\u03C3\u03B5\u03C4\u03B5.\n\u039C\u03B5
    \u03B4\u03CD\u03BF \u03B4\u03AC\u03C7\u03C4\u03C5\u03BB\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
    \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C8\u03B5\u03C4\u03B5
    \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1, \u03B4\u03C9\u03BC\u03AC\u03C4\u03B9\u03B1
    \u03BA\u03B1\u03B9 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2.\n\u03A4\u03B1 \u03B5\u03C1\u03B3\u03B1\u03BB\u03B5\u03AF\u03B1
    \u03C3\u03B1\u03C2 \u03C3\u03AD\u03C1\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C9
    \u03C3\u03B5 \u03CC,\u03C4\u03B9 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9.\n\u03A4\u03B1
    \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1 \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03BF \u03C3\u03B7\u03BC\u03B5\u03B9\u03C9\u03BC\u03B1\u03C4\u03AC\u03C1\u03B9\u03BF."
