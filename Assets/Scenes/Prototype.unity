  m_text: "\n\u0393\u03AC\u03BB\u03B1, \u03B3\u03BB\u03CD\u03BA\u03B1 \u03BA\u03B1\u03B9
    \u03C0\u03AC\u03B3\u03BF\u03C2 \u03B1\u03BD\u03B1\u03BA\u03B1\u03C4\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
