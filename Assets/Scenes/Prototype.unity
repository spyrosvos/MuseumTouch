  m_text: "\n\u03A3\u2019 \u03AD\u03BD\u03B1 \u03C3\u03B1\u03BB\u03CC\u03BD\u03B9,
    \u03C4\u03BF \u03AD\u03C0\u03B9\u03C0\u03BB\u03BF \u03B4\u03B5\u03BD \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF
    \u03BC\u03CC\u03BD\u03BF \u03C4\u03B7\u03BD \u03AC\u03BD\u03B5\u03C3\u03B7, \u03B1\u03BB\u03BB\u03AC
    \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \"\u03B5\u03B9\u03BA\u03CC\u03BD\u03B1\".
    \u03A4\u03B1 \u03B4\u03B9\u03B1\u03BA\u03BF\u03C3\u03BC\u03B7\u03C4\u03B9\u03BA\u03AC
    \u03BC\u03BF\u03C4\u03AF\u03B2\u03B1 \u03C6\u03B1\u03BD\u03B5\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE \u03C4\u03B7\u03C2
    \u0395\u03C5\u03C1\u03CE\u03C0\u03B7\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
    \u03C4\u03AC\u03BE\u03B7 \u03C4\u03B7\u03C2 \u0395\u03C1\u03BC\u03BF\u03CD\u03C0\u03BF\u03BB\u03B7\u03C2."
