  m_text: "\u039C\u03C0\u03C1\u03AC\u03B2\u03BF \u03C3\u03B1\u03C2, \u03C1\u03B5\u03C0\u03CC\u03C1\u03C4\u03B5\u03C1!
    \u0391\u03C5\u03C4\u03CC \u03B8\u03B1 \u03C0\u03B5\u03B9 \u03B4\u03B7\u03BC\u03BF\u03C3\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE
