  m_text: " \u03A3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1
    \u03B7 \u03B4\u03C9\u03C1\u03B5\u03AC \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD
