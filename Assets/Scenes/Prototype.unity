  m_text: "\u0395\u03B4\u03CE \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9
    \u03B7 \u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03C4\u03C5\u03C0\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
    \u0397\u03BB\u03AF\u03B1 \u039A\u03C5\u03C1\u03B9\u03B1\u03B6\u03CC\u03C0\u03BF\u03C5\u03BB\u03BF\u03C5.
    \u038C,\u03C4\u03B9 \u03C4\u03C5\u03C0\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
    \u03C0\u03CC\u03BB\u03B7 \u03C0\u03B5\u03C1\u03BD\u03AC \u03B1\u03C0\u03CC \u03C4\u03B1
    \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C4\u03BF\u03C5. \u039A\u03B1\u03B9 \u03C4\u03BF
    \u03C7\u03B1\u03C1\u03C4\u03AF, \u03CC\u03C0\u03C9\u03C2 \u03BE\u03AD\u03C1\u03BF\u03C5\u03BC\u03B5,
    \u03AD\u03C7\u03B5\u03B9 \u03BC\u03BD\u03AE\u03BC\u03B7\u2026"
