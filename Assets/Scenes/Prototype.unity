--- !u!114 &1619098204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1619098202}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u039C\u03B9\u03B1 \u03B1\u03BD\u03CE\u03BD\u03C5\u03BC\u03B7 \u03B5\u03C0\u03B9\u03C3\u03C4\u03BF\u03BB\u03AE
    \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1 \u03C3\u03C4\u03BF
    \u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03BF \u03BC\u03BF\u03C5. \u03A0\u03AF\u03C3\u03C9
    \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7
    \u03C6\u03B9\u03BB\u03B1\u03BD\u03B8\u03C1\u03C9\u03C0\u03B9\u03BA\u03AE \u03B4\u03C9\u03C1\u03B5\u03AC
    \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03C1\u03CD\u03B2\u03B5\u03C4\u03B1\u03B9
    \u03AD\u03BD\u03B1\u03C2 \u03BC\u03C5\u03C3\u03C4\u03B7\u03C1\u03B9\u03CE\u03B4\u03B7\u03C2
    \u03B5\u03C5\u03B5\u03C1\u03B3\u03AD\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2
    \u03B4\u03B5\u03BD \u03BA\u03B1\u03C4\u03AC\u03C6\u03B5\u03C1\u03B5 \u03C0\u03BF\u03C4\u03AD
    \u03BD\u03B1 \u03B1\u03C0\u03BF\u03BA\u03B1\u03BB\u03CD\u03C8\u03B5\u03B9.\r\n\u0398\u03AD\u03BB\u03C9
    \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C3\u03C4\u03BF
    \u03C0\u03C1\u03C9\u03C4\u03BF\u03C3\u03AD\u03BB\u03B9\u03B4\u03BF. \u03A3\u03B5
    \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03B1\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD
    \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u2014 \u03BC\u03B1\u03B6\u03AD\u03C8\u03C4\u03B5
    \u03C4\u03B1 \u03CC\u03BB\u03B1, \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03C3\u03C4\u03B5
    \u03C4\u03B1 \u03AD\u03BE\u03C5\u03C0\u03BD\u03B1, \u03BA\u03B1\u03B9 \u03C6\u03AD\u03C1\u03C4\u03B5
    \u03BC\u03BF\u03C5 \u03C4\u03B7\u03BD \u03B1\u03BB\u03AE\u03B8\u03B5\u03B9\u03B1.\r\n\u0392\u03C1\u03B5\u03AF\u03C4\u03B5
    \u03C4\u03BF\u03BD \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
    \u03B5\u03C5\u03B5\u03C1\u03B3\u03AD\u03C4\u03B7 \u2014 \u03C0\u03C1\u03B9\u03BD
    \u03C3\u03C4\u03B5\u03B3\u03BD\u03CE\u03C3\u03B5\u03B9 \u03C4\u03BF \u03BC\u03B5\u03BB\u03AC\u03BD\u03B9!"
  m_isRightToLeft: 0
